[Unit]
Description=Calculation Power Feedback API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/calculation-power/server
Environment=FEEDBACK_DB=/var/lib/calculation-power/feedback.sqlite3
ExecStart=/var/www/calculation-power/server/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 10889
Restart=on-failure

[Install]
WantedBy=multi-user.target
